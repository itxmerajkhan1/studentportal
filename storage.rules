rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "itxmerajkhan3109@gmail.com" ||
        request.auth.token.email.lower() == "itxmairajkhan@gmail.com" ||
        request.auth.token.email.lower() == "itxmirajkhan@gmail.com" ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        firestore.exists(/databases/ai-studio-merajlearningpor-bb0c80a7-f372-43a5-a1b6-a3cebb3f3bc4/documents/admins/$(request.auth.uid))
      );
    }

    function isApprovedStudent() {
      return isSignedIn() && (
        isAdmin() ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'approved' ||
        firestore.get(/databases/ai-studio-merajlearningpor-bb0c80a7-f372-43a5-a1b6-a3cebb3f3bc4/documents/users/$(request.auth.uid)).data.status == 'approved'
      );
    }

    // Video lectures - uploaded and managed exclusively by administrator
    match /videos/{allPaths=**} {
      allow read: if isApprovedStudent();
      allow write: if isAdmin()
        && (request.resource.contentType.matches('video/.*') || request.resource.contentType == 'application/octet-stream')
        && request.resource.size <= 500 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Lecture PDF notes - uploaded and managed exclusively by administrator
    match /lecture_notes/{allPaths=**} {
      allow read: if isApprovedStudent();
      allow write: if isAdmin()
        && request.resource.contentType == 'application/pdf'
        && request.resource.size <= 25 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Payment receipts uploaded by students for verification
    match /receipts/{allPaths=**} {
      allow create: if isSignedIn() && request.resource.size <= 5 * 1024 * 1024;
      allow read: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
